{#
  Teaser Knowledge Hub: kartu dengan pill jenis, pill tingkat kesulitan, judul,
  ringkasan, dan tag. Seluruh kartu bisa diklik lewat pseudo-element di tautan judul.
#}
<article{{ attributes.addClass('teaser') }}>
  {% if kh.bookmark %}{% include '@kh_theme/kh-bookmark-button.html.twig' with { nid: node.id, title: node.label, url: url, jenis: kh.jenis, snippet: kh.ringkasan, icon_only: true } only %}{% endif %}
  <div class="teaser-row">
    {% if kh.jenis %}<span class="teaser-type">{{ kh.jenis }}</span>{% endif %}
    {% if kh.diff %}<span class="teaser-level">{{ kh.diff }}</span>{% endif %}
  </div>
  <h3><a href="{{ url }}" rel="bookmark">{{ label }}</a></h3>
  {% if kh.ringkasan %}<p>{{ kh.ringkasan }}</p>{% endif %}
  {% if kh.tags %}<ul class="tags">{% for t in kh.tags %}<li>{{ t }}</li>{% endfor %}</ul>{% endif %}
</article>
