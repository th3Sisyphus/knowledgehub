{#
  Halaman Knowledge Hub: header pill melayang, konten, footer kartu.
  Beranda (is_front) dirender penuh oleh modul kh_home. Halaman lain: facet kiri,
  konten tengah, terkait kanan. Kelas di sini dipakai CSS dan JS; ubah berdua.
#}
<header class="site-header">
  <a class="site-branding" href="{{ path('<front>') }}" rel="home">
    <span class="kh-mark">{{ kh_mark_gradient }}</span>
    <span class="site-branding-text">
      <span class="site-name">{{ site_name }}</span>
      <span class="site-slogan">Pusat Pengetahuan Internal</span>
    </span>
  </a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    <span>Menu</span>
  </button>
  <nav class="primary-nav" id="primary-nav" aria-label="Navigasi utama">{{ page.primary_menu }}</nav>
  <form class="header-search" action="{{ path('view.kh_katalog.page_cari') }}" method="get" role="search">
    <label for="q-header" class="visually-hidden">Cari di Knowledge Hub</label>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <input id="q-header" name="search_api_fulltext" type="search" placeholder="Cari…" data-kh-palette autocomplete="off">
    <kbd class="kbd-hint" aria-hidden="true">Ctrl K</kbd>
    <button type="submit" aria-label="Cari">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h13M12 5l7 7-7 7"/></svg>
    </button>
  </form>
  <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Ganti mode gelap atau terang">
    <span class="i-sun" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg></span>
    <span class="i-moon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></span>
  </button>
</header>

<main id="main-content" tabindex="-1">
  {{ page.highlighted }}
  {% if is_front %}
    {{ page.content }}
  {% else %}
    <div class="wrap page-shell">
      {{ page.breadcrumb }}
      {{ page.help }}
      <div class="layout{% if page.sidebar_first %} layout--facets{% endif %}{% if page.sidebar_second %} layout--node{% endif %}">
        {% if page.sidebar_first %}<aside class="sidebar facets" aria-label="Filter">{{ page.sidebar_first }}</aside>{% endif %}
        <div class="main-col">
          {% if not node %}{{ page.page_title }}{% endif %}
          {{ page.content }}
        </div>
        {% if page.sidebar_second %}<aside class="sidebar related">{{ page.sidebar_second }}</aside>{% endif %}
      </div>
    </div>
  {% endif %}
</main>

<footer class="site-footer">
  <div class="wrap footer-cta">
    <section class="cta">
      <h2>Tidak menemukan yang dicari?</h2>
      <p>Tanyakan ke Helpdesk IT atau telusuri panduan yang tersedia. Kami bantu arahkan ke dokumen yang tepat.</p>
      <div class="cta-actions">
        <a class="button button--primary" href="/bantuan">Lihat halaman Bantuan</a>
        <a class="button" href="mailto:km@organisasi.example">Kirim pertanyaan</a>
      </div>
    </section>
  </div>
  <div class="footer-card">
    <div class="footer-grid">
      <div class="footer-brand">
        {{ kh_mark_white }}
        <span class="site-name">{{ site_name }}</span>
        <p>Pusat pengetahuan internal organisasi. Dikelola Knowledge Manager dengan review berkala.</p>
      </div>
      <nav aria-label="Area utama footer"><h2>Area</h2><ul>
        <li><a href="/prosedur">Prosedur</a></li><li><a href="/referensi">Referensi</a></li><li><a href="/pembelajaran">Pembelajaran</a></li><li><a href="/bantuan">Bantuan</a></li><li><a href="/alat-kerja">Alat Kerja</a></li>
      </ul></nav>
      <nav aria-label="Portal"><h2>Portal</h2><ul>
        <li><a href="{{ path('<front>') }}">Beranda</a></li><li><a href="/cari">Pencarian</a></li><li><a href="/user/login">Masuk Admin</a></li>
      </ul></nav>
      <div><h2>Butuh bantuan?</h2><p>Helpdesk IT ext. 300<br><a href="mailto:km@organisasi.example">km@organisasi.example</a></p></div>
    </div>
  </div>
  <p class="footer-bottom"><span>© 2026 Knowledge Hub Organisasi</span><span>Manajemen Konten Web</span></p>
</footer>
