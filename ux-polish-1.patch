new file mode 100644
index 0000000..38e5921
--- /dev/null
+++ b/modules/kh_feedback/kh_feedback.install
@@ -0,0 +1,29 @@
+<?php
+
+/**
+ * @file
+ * Skema tabel umpan balik konten.
+ */
+
+/**
+ * Implements hook_schema().
+ */
+function kh_feedback_schema() {
+  $schema['kh_feedback'] = [
+    'description' => 'Umpan balik pengunjung per konten.',
+    'fields' => [
+      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
+      'nid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
+      'helpful' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0],
+      'comment' => ['type' => 'text', 'size' => 'normal'],
+      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
+      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
+    ],
+    'primary key' => ['id'],
+    'indexes' => [
+      'nid' => ['nid'],
+      'created' => ['created'],
+    ],
+  ];
+  return $schema;
+}
diff --git a/modules/kh_feedback/kh_feedback.module b/modules/kh_feedback/kh_feedback.module
new file mode 100644
index 0000000..c3095d8
--- /dev/null
+++ b/modules/kh_feedback/kh_feedback.module
@@ -0,0 +1,17 @@
+<?php
+
+/**
+ * @file
+ * Umpan balik konten Knowledge Hub.
+ */
+
+/**
+ * Implements hook_ENTITY_TYPE_delete() untuk node.
+ *
+ * Umpan balik ikut dihapus bersama kontennya.
+ */
+function kh_feedback_node_delete($node) {
+  \Drupal::database()->delete('kh_feedback')
+    ->condition('nid', $node->id())
+    ->execute();
+}
