+/**
+ * Banner kesegaran dan status konten.
+ *
+ * Review Date = tanggal konten + 12 bulan (sama dengan blok review). Level:
+ * archived, preview (belum terbit), overdue (lewat review), soon (30 hari lagi).
+ * Hasil kosong berarti tidak ada banner.
+ */
+function kh_theme_freshness($state, $date) {
+  if ($state === 'archived') {
+    return [
+      'level' => 'archived',
+      'title' => 'Konten diarsipkan.',
+      'text' => 'Dokumen ini tidak lagi berlaku dan hanya disimpan sebagai riwayat.',
+    ];
+  }
+  if ($state !== 'published') {
+    return [
+      'level' => 'preview',
+      'title' => 'Pratinjau.',
+      'text' => 'Konten ini belum dipublikasikan dan hanya terlihat oleh pengguna yang berhak.',
+    ];
+  }
+  if ($date === '') {
+    return [];
+  }
+
+  $review_on = (new DateTimeImmutable($date))->modify('+12 months');
+  $today = new DateTimeImmutable('today');
+  $days_left = (int) $today->diff($review_on)->format('%r%a');
+
+  if ($days_left < 0) {
+    return [
+      'level' => 'overdue',
+      'title' => 'Perlu review.',
+      'text' => 'Jadwal review terlewat sejak ' . kh_theme_date($review_on->format('Y-m-d')) . '. Pastikan isinya masih berlaku sebelum dipakai.',
+    ];
+  }
+  if ($days_left <= 30) {
+    return [
+      'level' => 'soon',
+      'title' => 'Segera direview.',
+      'text' => 'Jadwal review pada ' . kh_theme_date($review_on->format('Y-m-d')) . '.',
+    ];
+  }
+  return [];
+}
