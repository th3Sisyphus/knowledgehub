+/**
+ * Implements hook_page_attachments_alter().
+ *
+ * Favicon dan gambar OG dari folder branding tema. Gambar OG hanya dipasang bila
+ * modul metatag belum mengisinya.
+ */
+function kh_theme_page_attachments_alter(array &$attachments) {
+  $base = '/' . \Drupal::service('extension.list.theme')->getPath('kh_theme') . '/branding/';
+
+  // Buang favicon bawaan Drupal supaya tidak bentrok dengan ikon tema.
+  foreach ($attachments['#attached']['html_head_link'] ?? [] as $key => $link) {
+    $rel = $link[0]['rel'] ?? '';
+    if ($rel === 'icon' || $rel === 'shortcut icon') {
+      unset($attachments['#attached']['html_head_link'][$key]);
+    }
+  }
+
+  $icons = [
+    ['rel' => 'icon', 'href' => $base . 'favicon.svg', 'type' => 'image/svg+xml'],
+    ['rel' => 'icon', 'href' => $base . 'favicon-32.png', 'type' => 'image/png', 'sizes' => '32x32'],
+    ['rel' => 'apple-touch-icon', 'href' => $base . 'apple-touch-icon.png'],
+  ];
+  foreach ($icons as $i => $icon) {
+    $attachments['#attached']['html_head'][] = [
+      ['#tag' => 'link', '#attributes' => $icon],
+      'kh_theme_icon_' . $i,
+    ];
+  }
+
+  $has_og_image = FALSE;
+  foreach ($attachments['#attached']['html_head'] ?? [] as $item) {
+    if (($item[0]['#attributes']['property'] ?? '') === 'og:image' || ($item[0]['#attributes']['name'] ?? '') === 'og:image') {
+      $has_og_image = TRUE;
+    }
+  }
+  if (!$has_og_image) {
+    $origin = \Drupal::request()->getSchemeAndHttpHost();
+    $attachments['#attached']['html_head'][] = [
+      ['#tag' => 'meta', '#attributes' => ['property' => 'og:image', 'content' => $origin . $base . 'og-image.png']],
+      'kh_theme_og_image',
+    ];
+    $attachments['#attached']['html_head'][] = [
+      ['#tag' => 'meta', '#attributes' => ['name' => 'twitter:card', 'content' => 'summary_large_image']],
+      'kh_theme_twitter_card',
+    ];
+    $attachments['#cache']['contexts'][] = 'url.site';
