+.palette-field svg { width: 1.15rem; height: 1.15rem; flex: none; color: var(--mute); }
+.palette-input { flex: 1; min-width: 0; padding: .25rem 0; border: 0; background: none; color: var(--ink); font: 400 1.05rem var(--font); }
