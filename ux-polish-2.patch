+.palette-list { margin: 0; padding: .5rem; list-style: none; overflow-y: auto; overscroll-behavior: contain; }
+.palette-group { padding: .6rem .75rem .25rem; font: 600 .7rem var(--font); letter-spacing: .08em; text-transform: uppercase; color: var(--mute); }
+.palette-option { display: grid; grid-template-columns: 1fr auto; gap: .1rem .75rem; align-items: center; padding: .6rem .75rem; border-radius: var(--r-md); cursor: pointer; }
+.palette-option.is-active { background: var(--accent-soft); }
+.palette-main { font-weight: 500; color: var(--ink); }
+.palette-main mark { background: none; color: var(--accent); font-weight: 700; }
+.palette-snippet { grid-column: 1; font-size: .85rem; color: var(--ink-soft); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.palette-tag { grid-row: 1; grid-column: 2; padding: .1rem .55rem; border-radius: var(--r-pill); background: var(--bg); border: 1px solid var(--line); font: 500 .7rem var(--font); color: var(--ink-soft); }
+.palette-option.is-active .palette-tag { background: var(--surface); }
+.palette-list[aria-busy="true"] { opacity: .6; }
+.palette-foot { display: flex; gap: 1rem; padding: .6rem 1.1rem; border-top: 1px solid var(--line); background: var(--bg); font-size: .75rem; color: var(--mute); }
+.palette-foot kbd { margin-right: .15rem; }
+@keyframes palette-in { from { opacity: 0; transform: translateY(-8px) scale(.98); } to { opacity: 1; transform: none; } }
+@media (max-width: 760px) {
+  .kbd-hint, .palette-foot { display: none; }
+  dialog.palette { margin-top: .75rem; max-height: calc(100vh - 1.5rem); }
+  .palette-input { font-size: 1rem; }
+}
+@media (prefers-reduced-motion: reduce) { dialog.palette[open] { animation: none; } }
