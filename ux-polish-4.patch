+/* ---------- Filter aktif dan drawer facet (mobile) ---------- */
+.facets-bar { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; margin: 0 0 1.25rem; }
+.facets-toggle { display: none; align-items: center; gap: .5rem; height: 2.5rem; padding: 0 1rem; border: 1px solid var(--line); border-radius: var(--r-pill); background: var(--surface); color: var(--ink); font: 500 .9rem var(--font); cursor: pointer; box-shadow: var(--shadow); }
+.facets-count { min-width: 1.35rem; height: 1.35rem; padding: 0 .35rem; border-radius: var(--r-pill); background: var(--accent); color: var(--accent-ink); font: 600 .75rem/1.35rem var(--font); text-align: center; }
+.facets-count[hidden] { display: none; }
+.active-filters { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; min-width: 0; }
+.active-filters ul { display: contents; margin: 0; padding: 0; list-style: none; }
+.active-filters li { list-style: none; }
+.chip--removable { display: inline-flex; align-items: center; gap: .45rem; }
+.chip-x { font-size: 1.05em; line-height: 1; color: var(--mute); }
+.chip--removable:hover .chip-x { color: var(--accent); }
+.active-filters-clear, .facets-clear { font: 500 .85rem var(--font); color: var(--ink-soft); text-decoration: underline; text-underline-offset: 3px; }
+.facets-head, .facets-foot, .facets-backdrop { display: none; }
+@media (min-width: 861px) { .facets-bar.is-empty { display: none; } }
+@media (max-width: 860px) {
+  .facets-toggle { display: inline-flex; }
+  html.facets-open { overflow: hidden; }
+  .facets-js .facets { position: fixed; inset: auto 0 0 0; z-index: 70; max-height: min(85vh, 720px); padding: 0 1.25rem; overflow-y: auto; overscroll-behavior: contain; border-bottom: 0; border-radius: var(--r-lg) var(--r-lg) 0 0; box-shadow: var(--shadow-lift); transform: translateY(100%); visibility: hidden; transition: transform .25s ease, visibility 0s linear .25s; }
+  .facets-open .facets { transform: none; visibility: visible; transition: transform .25s ease, visibility 0s; }
+  .facets-js .facets-head { position: sticky; top: 0; z-index: 1; display: flex; align-items: center; justify-content: space-between; margin: 0 -1.25rem 1rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--line); background: var(--surface); font-size: 1.05rem; }
+  .facets-close { padding: .35rem .8rem; border: 1px solid var(--line); border-radius: var(--r-pill); background: var(--bg); color: var(--ink); font: 500 .85rem var(--font); cursor: pointer; }
+  .facets-js .facets-foot { position: sticky; bottom: 0; display: flex; align-items: center; gap: 1rem; margin: 1rem -1.25rem 0; padding: .9rem 1.25rem calc(.9rem + env(safe-area-inset-bottom)); border-top: 1px solid var(--line); background: var(--surface); }
+  .facets-js .facets-backdrop { position: fixed; inset: 0; z-index: 65; display: block; background: rgba(11, 20, 55, .45); opacity: 0; pointer-events: none; transition: opacity .25s ease; }
+  .facets-open .facets-backdrop { opacity: 1; pointer-events: auto; }
+}
+@media (prefers-reduced-motion: reduce) { .facets-js .facets, .facets-js .facets-backdrop { transition: none !important; } }
+@media print { .facets-bar, .facets-backdrop { display: none !important; } }
