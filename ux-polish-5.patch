+{#
+  Tombol simpan (bookmark). Status dan label diatur js/bookmarks.js.
+
+  Variabel: nid, title, url, jenis, snippet, icon_only (true = hanya ikon).
+  Nama aksesibel tetap ("Simpan: judul"); status lewat aria-pressed.
+#}
+<button type="button" class="bookmark-btn{% if icon_only %} bookmark-btn--icon{% endif %}" data-kh-bookmark data-nid="{{ nid }}" data-title="{{ title }}" data-url="{{ url }}" data-jenis="{{ jenis }}" data-snippet="{{ (snippet|default(''))|striptags|slice(0, 160) }}" aria-pressed="false" aria-label="Simpan: {{ title }}">
